---
import "../styles/global.css";

const products = [
  {
    name: "La Caminante",
    category: "Campo",
    price: 189,
    color: "Cuero miel",
    badge: "Más vendida",
    image:
      "https://images.unsplash.com/photo-1608256246200-53e635b5b65f?auto=format&fit=crop&w=900&q=85",
    position: "center 58%",
  },
  {
    name: "La Andariega",
    category: "Ciudad",
    price: 215,
    color: "Negro profundo",
    badge: "",
    image:
      "https://images.unsplash.com/photo-1543163521-1bf539c55dd2?auto=format&fit=crop&w=900&q=85",
    position: "center 58%",
  },
  {
    name: "La Serrana",
    category: "Campo",
    price: 198,
    color: "Arena tostada",
    badge: "Nueva",
    image:
      "https://images.unsplash.com/photo-1520639888713-7851133b1ed0?auto=format&fit=crop&w=900&q=85",
    position: "center 55%",
  },
  {
    name: "La Viajera",
    category: "Aventura",
    price: 229,
    color: "Oliva envejecido",
    badge: "",
    image:
      "https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=900&q=85",
    position: "center 58%",
  },
];

const filters = ["Todas", "Campo", "Ciudad", "Aventura"];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f8f7f3" />
    <meta
      name="description"
      content="Botas hechas para durar y para ir más lejos. Descubre la colección de botas de cuero de Taller del Sur."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap"
      rel="stylesheet"
    />
    <title>Taller del Sur — Botas hechas para ir más lejos</title>
  </head>
  <body>
    <div class="bg-ink px-4 py-2 text-center text-[10px] font-medium tracking-[0.13em] text-white sm:text-[11px]">
      ENVÍO GRATIS EN PEDIDOS +$150 <span class="px-2 text-white/40">·</span> HECHAS PARA DURAR
    </div>

    <header class="relative z-20 border-b border-ink/10 bg-paper">
      <div class="mx-auto flex h-[76px] max-w-[1440px] items-center justify-between px-5 sm:px-8 lg:h-[84px] lg:px-14">
        <button
          id="menu-toggle"
          class="flex h-10 w-10 items-center justify-center lg:hidden"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </button>

        <nav class="hidden items-center gap-8 text-[11px] font-medium uppercase tracking-[0.12em] lg:flex" aria-label="Navegación principal">
          <a class="transition-colors hover:text-rust" href="#coleccion">Botas</a>
          <a class="transition-colors hover:text-rust" href="#hechas-a-mano">Nuestra forma</a>
          <a class="transition-colors hover:text-rust" href="#historia">Diario</a>
        </nav>

        <a href="#" class="absolute left-1/2 -translate-x-1/2 text-center" aria-label="Taller del Sur, inicio">
          <span class="block font-serif text-[25px] leading-none tracking-[-0.04em] sm:text-[29px]">taller<span class="text-rust">.</span></span>
          <span class="mt-1 block text-[8px] font-medium uppercase tracking-[0.31em]">del sur</span>
        </a>

        <div class="flex items-center gap-1 sm:gap-3">
          <a href="#coleccion" class="hidden px-2 text-[11px] font-medium uppercase tracking-[0.12em] transition-colors hover:text-rust sm:block">Buscar</a>
          <button
            id="cart-toggle"
            class="flex items-center gap-2 px-1 py-2 text-[11px] font-medium uppercase tracking-[0.1em]"
            aria-label="Abrir bolsa de compras, 0 artículos"
          >
            <svg viewBox="0 0 24 24" fill="none" class="h-[19px] w-[19px]" aria-hidden="true">
              <path d="M5 8.5h14l1 12H4l1-12Z" stroke="currentColor" stroke-width="1.4" />
              <path d="M9 9V6a3 3 0 0 1 6 0v3" stroke="currentColor" stroke-width="1.4" />
            </svg>
            <span class="hidden sm:inline">Bolsa</span>
            <span id="cart-count" class="grid h-[19px] min-w-[19px] place-items-center rounded-full bg-ink px-1 text-[9px] text-white">0</span>
          </button>
        </div>
      </div>

      <nav id="mobile-menu" class="absolute inset-x-0 top-full hidden border-t border-ink/10 bg-paper px-6 py-6 shadow-lg lg:hidden" aria-label="Navegación móvil">
        <div class="flex flex-col gap-5 text-xs font-medium uppercase tracking-[0.12em]">
          <a href="#coleccion">Botas</a>
          <a href="#hechas-a-mano">Nuestra forma</a>
          <a href="#historia">Diario</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="relative isolate min-h-[570px] overflow-hidden bg-[#51453a] sm:min-h-[650px] lg:min-h-[700px]">
        <img
          class="absolute inset-0 -z-20 h-full w-full object-cover object-[57%_center]"
          src="https://images.unsplash.com/photo-1472396961693-142e6e269027?auto=format&fit=crop&w=2200&q=90"
          alt=""
          fetchpriority="high"
        />
        <div class="absolute inset-0 -z-10 bg-gradient-to-r from-[#201e19]/80 via-[#201e19]/45 to-[#201e19]/10"></div>
        <div class="mx-auto flex min-h-[570px] max-w-[1440px] items-center px-6 py-20 sm:min-h-[650px] sm:px-10 lg:min-h-[700px] lg:px-20">
          <div class="max-w-[570px] text-white">
            <p class="mb-6 text-[10px] font-medium uppercase tracking-[0.24em] text-white/75 sm:text-xs">Hechas a mano, para ir más lejos</p>
            <h1 class="font-serif text-[58px] leading-[0.96] tracking-[-0.035em] sm:text-[76px] lg:text-[92px]">
              El camino<br />es tuyo<span class="text-[#d89a70]">.</span>
            </h1>
            <p class="mt-6 max-w-[380px] text-sm leading-6 text-white/80 sm:text-base sm:leading-7">
              Botas de cuero honesto, hechas sin prisa. Para los días que empiezan sin mapa.
            </p>
            <a
              href="#coleccion"
              class="mt-9 inline-flex items-center gap-8 border border-white/60 px-6 py-4 text-[10px] font-semibold uppercase tracking-[0.16em] transition-colors hover:border-white hover:bg-white hover:text-ink"
            >
              Encuentra tu par
              <span aria-hidden="true">↗</span>
            </a>
            <div class="mt-14 flex items-center gap-3 text-[10px] uppercase tracking-[0.15em] text-white/70">
              <span class="h-px w-8 bg-white/60"></span>
              Oficio que se lleva puesto
            </div>
          </div>
        </div>
        <div class="absolute bottom-8 right-7 hidden text-[9px] uppercase tracking-[0.2em] text-white/70 [writing-mode:vertical-rl] lg:block">
          Desde el sur, desde siempre
        </div>
      </section>

      <section id="coleccion" class="scroll-mt-8 px-5 py-20 sm:px-8 sm:py-24 lg:px-14 lg:py-28">
        <div class="mx-auto max-w-[1300px]">
          <div class="flex flex-col justify-between gap-8 sm:flex-row sm:items-end">
            <div>
              <p class="mb-4 text-[10px] font-semibold uppercase tracking-[0.2em] text-rust">Piezas para toda la vida</p>
              <h2 class="font-serif text-[42px] leading-none tracking-[-0.025em] sm:text-[54px]">Encuentra tu camino</h2>
            </div>
            <p class="max-w-[310px] text-sm leading-6 text-ink/65">
              Cuero seleccionado, manos expertas y detalles que mejoran con los años.
            </p>
          </div>

          <div class="mt-10 flex flex-wrap gap-x-7 gap-y-4 border-b border-ink/10 pb-4 sm:mt-14">
            {filters.map((filter, index) => (
              <button
                class="filter-button relative text-[11px] font-medium uppercase tracking-[0.12em] text-ink/55 transition-colors hover:text-rust"
                data-filter={filter}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                {filter}
              </button>
            ))}
            <span id="product-count" class="ml-auto self-center text-[10px] uppercase tracking-[0.12em] text-ink/45">04 modelos</span>
          </div>

          <div id="product-grid" class="mt-7 grid grid-cols-2 gap-x-3 gap-y-9 sm:gap-x-5 sm:gap-y-12 lg:grid-cols-4 lg:gap-x-6">
            {products.map((product) => (
              <article class="product-card group" data-category={product.category}>
                <div class="relative aspect-[0.78] overflow-hidden bg-sand">
                  <img
                    class="product-image h-full w-full object-cover"
                    src={product.image}
                    alt={`Botas ${product.name} en color ${product.color}`}
                    loading="lazy"
                    style={`object-position: ${product.position}`}
                  />
                  {product.badge && (
                    <span class="absolute left-3 top-3 bg-paper px-2.5 py-1.5 text-[8px] font-semibold uppercase tracking-[0.12em] sm:left-4 sm:top-4 sm:text-[9px]">
                      {product.badge}
                    </span>
                  )}
                  <button
                    class="add-to-cart absolute bottom-3 right-3 grid h-9 w-9 place-items-center rounded-full bg-paper text-ink shadow-sm transition-colors hover:bg-ink hover:text-white sm:bottom-4 sm:right-4 sm:h-10 sm:w-10"
                    data-product={product.name}
                    data-price={product.price}
                    aria-label={`Añadir ${product.name} a la bolsa`}
                  >
                    <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true">
                      <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                  </button>
                </div>
                <div class="flex items-start justify-between gap-2 pt-4">
                  <div>
                    <h3 class="font-serif text-[17px] leading-tight sm:text-[20px]">{product.name}</h3>
                    <p class="mt-1.5 text-[10px] text-ink/55 sm:text-xs">{product.color} <span class="px-1">·</span> {product.category}</p>
                  </div>
                  <p class="pt-0.5 text-[11px] font-medium sm:text-xs">${product.price}</p>
                </div>
              </article>
            ))}
          </div>

          <div id="empty-state" class="hidden py-20 text-center text-sm text-ink/55">No hay modelos en esta categoría por ahora.</div>

          <div class="mt-14 text-center sm:mt-20">
            <a href="#coleccion" class="inline-flex items-center gap-4 border-b border-ink/50 pb-2 text-[10px] font-semibold uppercase tracking-[0.14em] transition-colors hover:border-rust hover:text-rust">
              Ver toda la colección <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>

      <section id="hechas-a-mano" class="grid bg-[#eae6dd] lg:grid-cols-2">
        <div class="relative min-h-[340px] overflow-hidden sm:min-h-[460px]">
          <img
            src="https://images.unsplash.com/photo-1520639888713-7851133b1ed0?auto=format&fit=crop&w=1400&q=85"
            alt="Detalle de cuero trabajado a mano"
            class="absolute inset-0 h-full w-full object-cover object-center"
            loading="lazy"
          />
        </div>
        <div class="flex items-center px-7 py-16 sm:px-14 sm:py-20 lg:px-20">
          <div class="max-w-[460px]">
            <p class="mb-5 text-[10px] font-semibold uppercase tracking-[0.2em] text-rust">Hecho con intención</p>
            <h2 class="font-serif text-[42px] leading-[1.03] tracking-[-0.03em] sm:text-[55px]">No hacemos botas.<br />Hacemos compañeras.</h2>
            <p class="mt-6 text-sm leading-7 text-ink/65">
              Cada par nace en nuestro taller, de cuero que cuenta su propia historia y de manos que conocen el oficio. Sin atajos. Sin temporadas.
            </p>
            <a href="#historia" class="mt-8 inline-flex items-center gap-4 border-b border-ink/50 pb-2 text-[10px] font-semibold uppercase tracking-[0.14em] transition-colors hover:border-rust hover:text-rust">
              Conoce nuestro oficio <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>

      <section id="historia" class="px-5 py-20 sm:px-8 sm:py-24 lg:px-14 lg:py-28">
        <div class="mx-auto max-w-[1050px] text-center">
          <p class="mb-5 text-[10px] font-semibold uppercase tracking-[0.2em] text-rust">El sur se lleva puesto</p>
          <p class="mx-auto max-w-[850px] font-serif text-[36px] leading-[1.16] tracking-[-0.025em] sm:text-[49px] lg:text-[58px]">
            “Hay cosas que no se explican. Se sienten cuando das el primer paso.”
          </p>
          <p class="mt-7 text-[10px] font-medium uppercase tracking-[0.18em] text-ink/55">Una historia de taller, tierra y camino</p>
        </div>
      </section>

      <section class="bg-[#d9d0c1] px-5 py-16 sm:px-8 sm:py-20 lg:px-14">
        <div class="mx-auto flex max-w-[1200px] flex-col justify-between gap-8 sm:flex-row sm:items-center">
          <div>
            <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-rust">Una carta desde el taller</p>
            <h2 class="mt-3 font-serif text-[32px] leading-tight sm:text-[40px]">Buenas historias, de vez en cuando.</h2>
          </div>
          <form id="newsletter-form" class="flex w-full max-w-[420px] border-b border-ink/45 pb-2">
            <label class="sr-only" for="email">Tu correo electrónico</label>
            <input id="email" name="email" type="email" placeholder="Tu correo electrónico" required class="min-w-0 flex-1 bg-transparent py-2 text-sm outline-none placeholder:text-ink/55" />
            <button class="ml-4 text-[10px] font-semibold uppercase tracking-[0.14em] transition-colors hover:text-rust" type="submit">Apuntarme ↗</button>
          </form>
        </div>
        <p id="newsletter-message" class="mx-auto mt-4 hidden max-w-[1200px] text-xs text-ink/65" role="status"></p>
      </section>
    </main>

    <footer class="bg-ink px-5 py-10 text-white sm:px-8 lg:px-14">
      <div class="mx-auto flex max-w-[1300px] flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <a href="#" class="font-serif text-[29px] tracking-[-0.04em]">taller<span class="text-[#d89a70]">.</span></a>
          <p class="mt-2 text-[9px] uppercase tracking-[0.25em] text-white/55">del sur · desde 1987</p>
        </div>
        <div class="flex flex-wrap gap-x-6 gap-y-3 text-[9px] uppercase tracking-[0.12em] text-white/65">
          <a href="#hechas-a-mano" class="hover:text-white">Nuestra historia</a>
          <a href="#coleccion" class="hover:text-white">Envíos y devoluciones</a>
          <a href="#coleccion" class="hover:text-white">Contacto</a>
        </div>
        <p class="text-[9px] tracking-[0.08em] text-white/45">© 2025 Taller del Sur. Hecho para durar.</p>
      </div>
    </footer>

    <div id="toast" class="pointer-events-none fixed bottom-5 left-1/2 z-50 -translate-x-1/2 translate-y-4 bg-ink px-5 py-3 text-xs text-white opacity-0 shadow-lg transition-all" role="status" aria-live="polite"></div>

    <script>
      const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".filter-button"));
      const products = Array.from(document.querySelectorAll<HTMLElement>(".product-card"));
      const productCount = document.querySelector<HTMLElement>("#product-count");
      const emptyState = document.querySelector<HTMLElement>("#empty-state");
      const cartCount = document.querySelector<HTMLElement>("#cart-count");
      const cartToggle = document.querySelector<HTMLButtonElement>("#cart-toggle");
      const toast = document.querySelector<HTMLElement>("#toast");
      const menuToggle = document.querySelector<HTMLButtonElement>("#menu-toggle");
      const mobileMenu = document.querySelector<HTMLElement>("#mobile-menu");
      let cartTotal = 0;
      let toastTimeout: number;

      filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const filter = button.dataset.filter;
          let visibleCount = 0;

          filterButtons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
          products.forEach((product) => {
            const visible = filter === "Todas" || product.dataset.category === filter;
            product.hidden = !visible;
            if (visible) visibleCount += 1;
          });

          if (productCount) productCount.textContent = `${String(visibleCount).padStart(2, "0")} modelos`;
          emptyState?.classList.toggle("hidden", visibleCount !== 0);
        });
      });

      document.querySelectorAll<HTMLButtonElement>(".add-to-cart").forEach((button) => {
        button.addEventListener("click", () => {
          cartTotal += 1;
          if (cartCount) cartCount.textContent = String(cartTotal);
          cartToggle?.setAttribute("aria-label", `Bolsa de compras, ${cartTotal} ${cartTotal === 1 ? "artículo" : "artículos"}`);
          if (toast) {
            toast.textContent = `${button.dataset.product} añadido a tu bolsa · $${button.dataset.price}`;
            toast.classList.remove("translate-y-4", "opacity-0");
            window.clearTimeout(toastTimeout);
            toastTimeout = window.setTimeout(() => toast.classList.add("translate-y-4", "opacity-0"), 2600);
          }
        });
      });

      cartToggle?.addEventListener("click", () => {
        if (toast) {
          toast.textContent = cartTotal === 0
            ? "Tu bolsa está esperando una buena aventura."
            : `Tienes ${cartTotal} ${cartTotal === 1 ? "par" : "pares"} en tu bolsa.`;
          toast.classList.remove("translate-y-4", "opacity-0");
          window.clearTimeout(toastTimeout);
          toastTimeout = window.setTimeout(() => toast.classList.add("translate-y-4", "opacity-0"), 2600);
        }
      });

      menuToggle?.addEventListener("click", () => {
        const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
        menuToggle.setAttribute("aria-expanded", String(!isOpen));
        menuToggle.setAttribute("aria-label", isOpen ? "Abrir menú" : "Cerrar menú");
        mobileMenu?.classList.toggle("hidden", isOpen);
        document.body.classList.toggle("menu-open", !isOpen);
      });

      mobileMenu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          menuToggle?.setAttribute("aria-expanded", "false");
          menuToggle?.setAttribute("aria-label", "Abrir menú");
          mobileMenu.classList.add("hidden");
          document.body.classList.remove("menu-open");
        });
      });

      const newsletter = document.querySelector<HTMLFormElement>("#newsletter-form");
      newsletter?.addEventListener("submit", (event) => {
        event.preventDefault();
        const message = document.querySelector<HTMLElement>("#newsletter-message");
        const email = new FormData(newsletter).get("email");
        if (message && typeof email === "string") {
          message.textContent = `¡Gracias! Te escribiremos a ${email} cuando haya novedades del taller.`;
          message.classList.remove("hidden");
          newsletter.reset();
        }
      });
    </script>
  </body>
</html>
